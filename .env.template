# Plantilla de variables de entorno del storefront.
# Copiar a .env.local y rellenar:  cp .env.template .env.local
#
# OJO: las NEXT_PUBLIC_* se INLINEAN en tiempo de compilacion. Al cambiar cualquiera
# hay que reiniciar el dev server (o rehacer el build); editarlas en caliente no basta.

# --- Backend de Medusa -----------------------------------------------------
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# La imprime `pnpm seed:mx` en el backend
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_<tu-publishable-key-de-medusa>

# --- Sitio -----------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_REGION=mx
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:8000
# Secreto compartido para las revalidaciones on-demand disparadas por el backend
REVALIDATE_SECRET=<un-secreto-cualquiera>

# --- Mercado Pago ----------------------------------------------------------
# Public key usada por el CardPayment Brick para tokenizar la tarjeta en el navegador.
# En SANDBOX debe tener prefijo TEST- y venir de una aplicacion de CHECKOUT API; la de
# una aplicacion de Checkout Pro sale como APP_USR- y el cobro falla con
# "401 code 7 Unauthorized use of live credentials". Es limitacion SOLO de sandbox:
# en produccion Checkout Pro funciona. Ver tests/README.md.
# Tiene que ser de la MISMA aplicacion que el MERCADOPAGO_ACCESS_TOKEN del backend.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-<tu-public-key-de-mercado-pago>

# --- Analitica (opcional) --------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Medios legados (opcional) --------------------------------------------
# Origen desde el que se sirven imagenes antiguas si no estan en el bucket actual
LEGACY_MEDIA_ORIGIN=

# --- Solo tests E2E de Checkout Pro (shell, no .env.local) -----------------
# MP_TEST_BUYER_USER / MP_TEST_BUYER_PASSWORD: cuenta comprador de sandbox
